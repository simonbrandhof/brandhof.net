---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../assets/logo.svg";
import Project from "../components/Project.astro";
import bloomImage from "../assets/bloom.jpg";
import wolfImage from "../assets/wolf.jpg";
import crbaImage from "../assets/crba.jpg";
import magicTomatoImage from "../assets/magictomato.jpg";
import yakBikeImage from "../assets/yakbike.jpg";
import the8impactImage from "../assets/the8impact.jpg";
import firegardImage from "../assets/firegard.png";
---

<BaseLayout title="Simon Brandhof">
  <main class="max-w-3xl mx-auto">
    <div class="p-4 md:p-8">
      <h1 class="text-white text-2xl font-serif">Simon Brandhof</h1>
      <div class="flex items-center gap-1 text-lightgray text-sm">
        <Logo class="w-3 h-3 inline-block" /> Millésime 1977
      </div>
    </div>
    <div class="p-4 md:p-8 text-lightgray text-lg">
      <p>
        Co-fondateur de <a href="https://en.wikipedia.org/wiki/Sonar_(company)" class="link">Sonar</a>, j'ai passé 15
        ans à développer des logiciels open-source pour améliorer la qualité et la sécurité du code source.
      </p>
      <p>
        Aujourd'hui je me concentre sur deux urgences : le climat et la chute de la biodiversité. Pour agir je mise sur
        le mécénat, l'entrepreneuriat et l'investissement à impact environnemental.
      </p>
      <p>Bref, je passe des lignes de code aux lignes d'action.</p>
    </div>
    <div class="flex gap-2 px-4 md:px-8 py-4">
      <a class="button !inline-flex items-center gap-2" href="https://www.linkedin.com/in/simonbrandhof/">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        LinkedIn</a
      >
      <a href="https://github.com/simonbrandhof" class="button !inline-flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        GitHub</a
      >
    </div>
    <div class="py-4 md:py-8">
      <h2 class="text-white text-lg font-serif px-4 md:px-8">Mécénat</h2>
      <ul class="mt-4 md:px-8 flex flex-col gap-16 md:gap-8">
        <Project image={bloomImage} alt="BLOOM" url="https://bloomassociation.org/">
          <div class="text-xs uppercase">Pêche</div>
          <p>
            <a href="https://bloomassociation.org/" class="link">BLOOM</a> se bat contre la destruction de l'océan, du climat
            et des pêcheurs artisans.
          </p>
          <p>
            Ses actions combine recherche scientifique indépendante, plaidoyer politique et sensibilisation citoyenne.
          </p>
        </Project>
        <Project image={wolfImage} url="https://www.wwf.fr/projets/entre-chien-et-loup" alt="WWF">
          <div class="text-xs uppercase">Le loup</div>
          Le programme "<a href="https://www.wwf.fr/projets/entre-chien-et-loup" class="link">Entre Chien et Loup</a>"
          du WWF protège les populations de loups en accompagnant les éleveurs confrontés à la prédation.</Project
        >
        <Project image={crbaImage} url="https://crba.fr/" alt="CRBA">
          <div class="text-xs uppercase">Sécurité alimentaire</div>
          Le <a href="https://crba.fr/" class="link">CRBA</a> (Centre de Ressources de Botanique Appliquée) collecte, conserve
          et étudie les semences pour ne sélectionner que les plus robustes et adaptées aux changements climatiques.
        </Project>
        <li class="px-4 md:px-0">
          et aussi <a href="https://margesauvage.org/" class="link">marge sauvage</a> (glaciers),
          <a href="https://seastemik.org/" class="link">Seastemik</a> (océans),
          <a href="https://oceanfdn.org/" class="link">Ocean Foundation</a> (océans),
          <a href="https://www.surfrider.fr/" class="link">Surfrider</a> (océans),
          <a href="https://fne.asso.fr/" class="link">FNE</a> (environnement),
          <a href="https://www.pollinis.org/" class="link">Pollinis</a> (pollinisateurs),
          <a href="https://www.lpo.fr/" class="link">LPO</a> (oiseaux),
          <a href="https://convergence-animaux-politique.fr/" class="link">Convergence Animaux Politique</a> (animaux),
          <a href="https://crba.fr/" class="link">CRBA</a> (agriculture),
          <a href="https://www.foodwatch.org/fr/accueil" class="link">Foodwatch</a> (alimentation), le projet de libre évolution
          de l'<a href="https://uicn.fr/" class="link">UICN</a>,
          <a href="https://www.foretprimaire-francishalle.org/" class="link">Francis Hallé</a> (forêt primaire),
          <a href="https://www.canopee.ong/" class="link">Canopée</a> (forêts),
          <a href="https://www.foretvivante.fr/" class="link">Forêt Vivante</a> (Haute-Savoie) et <a
            href="https://splann.org/"
            class="link">Splann!</a
          > (média breton).
        </li>
      </ul>
    </div>
    <div class="py-4 md:py-8">
      <h2 class="text-white text-lg font-serif px-4 md:px-8">Entreprises</h2>
      <ul class="mt-4 md:px-8 flex flex-col gap-16 md:gap-8">
        <Project image={magicTomatoImage} alt="MagicTomato" url="https://www.magictomato.ch/">
          <div class="text-xs uppercase">Alimentation</div>
          <a href="https://www.magictomato.ch/" class="link">MagicTomato</a> livre en Suisse Romande les meilleurs produits
          frais, pour une alimentation saine et locale.
        </Project>
        <Project image={yakBikeImage} alt="YakBike" url="https://www.yakbike.co/">
          <div class="text-xs uppercase">Mobilité douce</div>
          <a href="https://www.yakbike.co/" class="link">Yakbike</a> est le vélo-cargo électrique swiss-made qui révolutionne
          le transport urbain professionnel.</Project
        >
        <Project image={the8impactImage} alt="The 8 Impact" url="https://www.the8impact.com/">
          <div class="text-xs uppercase">Recyclage</div>
          <a href="https://www.the8impact.com/" class="link">THE 8 IMPACT</a> est une deeptech qui revalorise les plastiques
          et caoutchoucs des chaussures invendables ou usagées.</Project
        >
        <Project image={firegardImage} alt="MidGard" url="https://www.midgard-ai.com/">
          <div class="text-xs uppercase">Incendies</div>
          <a href="https://www.midgard-ai.com/" class="link">Midgard</a> développe des solutions innovantes pour aider la
          sécurité civile à faire face aux risques naturels.
        </Project>
      </ul>
    </div>

    <div class="p-4 md:p-8 text-xs">
      Images © BLOOM, CRBA, Shematic pour le YakBike, THE 8 IMPACT, Midgard, Nicolas Schopfer pour MagicTomato et <a
        href="https://www.flickr.com/photos/thewaspfactory74/">the Wasp Factory</a
      > pour le loup.
    </div>
  </main>
</BaseLayout>
