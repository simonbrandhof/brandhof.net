---
// HTML redirect from /en to https://www.brandhof.net
// Query param ?v=2 bypasses cached homepage that used to redirect to /fr (avoids infinite loop)
const redirectUrl = "https://www.brandhof.net/?v=2";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
    <link rel="canonical" href="https://www.brandhof.net" />
    <title>Redirecting...</title>
  </head>
  <body>
    <p><a href={redirectUrl}>Click here if you are not redirected</a>.</p>
  </body>
</html>
